#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

# =============================================================================
# NFTables Base Structure and Rules
# =============================================================================
# This file defines the base structure for NFTables firewall, including:
# - Table and chain definitions
# - Basic stateful connection handling
# - Default policies
# - Loopback interface handling
# - Connection tracking
# =============================================================================

{% if nftables_docker_aware | default(false) %}
table inet filter
delete table inet filter
{% else %}
flush ruleset
{% endif %}

# -----------------------------------------------------------------------------
# Define Base Filter Table
# -----------------------------------------------------------------------------
table inet filter {

    # Base chains for filtering
    chain input {
        type filter hook input priority 0; policy {{ nftables_input_default_policy | default('drop') }};

        # Allow loopback traffic (processed first for efficiency)
        iifname lo accept comment "Allow loopback traffic"
        iifname != lo ip daddr 127.0.0.0/8 drop comment "Drop traffic to loopback not coming from loopback"
        iifname != lo ip6 daddr ::1 drop comment "Drop traffic to loopback not coming from loopback"

        # Reject invalid connections
        ct state invalid drop comment "Drop invalid packets"

        # Allow established/related connections
        jump existing

        # Mandatory ICMPv6 control messages (RFC 4861 Neighbor Discovery, RFC 4443 errors).
        # These are permitted unconditionally regardless of nftables_ipv6_enabled, because
        # blocking them breaks Neighbor Discovery (ND), Multicast Listener Discovery (MLD),
        # and Path MTU Discovery (PMTUD).
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, destination-unreachable, time-exceeded, parameter-problem } counter accept comment "Allow mandatory ICMPv6 control messages"
        icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } counter accept comment "Allow MLD multicast control messages"

        # ICMP/Ping handling for input chain
        {% if nftables_ping_input.enabled | default(true) %}
        meta l4proto { icmp, ipv6-icmp } limit rate {{ nftables_ping_input.rate_limit | default('3/second') }} burst {{ nftables_ping_input.burst | default(4) }} packets {% if nftables_ping_input.log | default(false) %}log prefix "[nftables] : accept : input : icmp : "{% endif %} counter accept comment "{{ nftables_ping_input.comment | default('Allow limited ICMP/ping input') }}"
        {% endif %}

        # Jump to cluster input chain if enabled
        {% if nftables_cluster_enabled | default(false) %}
        jump cluster_input
        {% endif %}

        # Jump to user-defined input chain if enabled
        {% if nftables_user_defined_input_enabled | default(false) %}
        jump user_defined_input
        {% endif %}

        # Jump to security protection chain if enabled (evaluated after whitelists
        # so trusted cluster and user-defined traffic is not blocked by bogon filtering)
        {% if nftables_configure_security_rules | default(false) %}
        jump security_protection
        {% endif %}

        # Log dropped packets if enabled
        {% if nftables_log_input_dropped | default(true) %}
        limit rate {{ nftables_log_input_dropped_rate_limit | default('10/minute') }} burst {{ nftables_log_input_dropped_burst | default(10) }} packets log prefix "[nftables] : drop : input : " flags all counter comment "Log dropped input packets"
        {% endif %}
    }

    chain forward {
        type filter hook forward priority 0; policy {{ nftables_forward_default_policy | default('drop') }};

        # Reject invalid connections
        ct state invalid drop comment "Drop invalid packets"

        # Allow established/related connections
        jump existing

        # Allow container egress and inter-container traffic in docker-aware mode
        {% if nftables_docker_aware | default(false) %}
        {% for bridge_if in nftables_docker_aware_bridge_interfaces | default(['docker0']) %}
        iifname "{{ bridge_if }}" accept comment "Allow container egress and inter-container traffic"
        {% endfor %}
        {% endif %}

        # Jump to user-defined forward chain if enabled
        {% if nftables_user_defined_forward_enabled | default(false) %}
        jump user_defined_forward
        {% endif %}

        # Jump to security protection chain if enabled (evaluated after whitelists)
        {% if nftables_configure_security_rules | default(false) %}
        jump security_protection
        {% endif %}

        # Log dropped packets if enabled
        {% if nftables_log_forward_dropped | default(true) %}
        limit rate {{ nftables_log_forward_dropped_rate_limit | default('10/minute') }} burst {{ nftables_log_forward_dropped_burst | default(10) }} packets log prefix "[nftables] : drop : forward : " flags all counter comment "Log dropped forward packets"
        {% endif %}
    }

    chain output {
        type filter hook output priority 0; policy {{ nftables_output_default_policy | default('drop') }};

        # Allow loopback traffic (processed first for efficiency)
        oifname lo accept comment "Allow loopback traffic"

        # Reject invalid connections
        ct state invalid drop comment "Drop invalid packets"

        # Allow established/related connections
        jump existing

        # Mandatory ICMPv6 control messages (RFC 4861 Neighbor Discovery, RFC 4443 errors).
        # These are permitted unconditionally regardless of nftables_ipv6_enabled, because
        # blocking them breaks Neighbor Discovery (ND), Multicast Listener Discovery (MLD),
        # and Path MTU Discovery (PMTUD).
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert, packet-too-big, destination-unreachable, time-exceeded, parameter-problem } counter accept comment "Allow mandatory ICMPv6 control messages"
        icmpv6 type { mld-listener-query, mld-listener-report, mld-listener-done, mld2-listener-report } counter accept comment "Allow MLD multicast control messages"

        # ICMP/Ping handling for output chain
        {% if nftables_ping_output.enabled | default(true) %}
        meta l4proto { icmp, ipv6-icmp } limit rate {{ nftables_ping_output.rate_limit | default('6/second') }} burst {{ nftables_ping_output.burst | default(8) }} packets {% if nftables_ping_output.log | default(false) %}log prefix "[nftables] : accept : output : icmp : "{% endif %} counter accept comment "{{ nftables_ping_output.comment | default('Allow limited ICMP/ping output') }}"
        {% endif %}

        # Jump to cluster output chain if enabled
        {% if nftables_cluster_enabled | default(false) %}
        jump cluster_output
        {% endif %}

        # Jump to user-defined output chain if enabled
        {% if nftables_user_defined_output_enabled | default(false) %}
        jump user_defined_output
        {% endif %}

        # Log dropped packets if enabled
        {% if nftables_log_output_dropped | default(true) %}
        limit rate {{ nftables_log_output_dropped_rate_limit | default('10/minute') }} burst {{ nftables_log_output_dropped_burst | default(10) }} packets log prefix "[nftables] : drop : output : " flags all counter comment "Log dropped output packets"
        {% endif %}
    }

    # Chain for handling established/related connections
    chain existing {
        # Allow established/related connections
        ct state { established, related } counter accept comment "Allow established/related connections"
    }

    {% if nftables_configure_security_rules | default(false) %}
    # Define security protection chain stub for rule augmentation
    chain security_protection {
    }
    {% endif %}

    {% if nftables_cluster_enabled | default(false) %}
    # Define cluster chain stubs for rule augmentation
    chain cluster_input {
    }

    chain cluster_output {
    }
    {% endif %}

    {% if nftables_user_defined_input_enabled | default(false) %}
    # Define user-defined input chain stub for rule augmentation
    chain user_defined_input {
    }
    {% endif %}

    {% if nftables_user_defined_forward_enabled | default(false) %}
    # Define user-defined forward chain stub for rule augmentation
    chain user_defined_forward {
    }
    {% endif %}

    {% if nftables_user_defined_output_enabled | default(false) %}
    # Define user-defined output chain stub for rule augmentation
    chain user_defined_output {
    }
    {% endif %}
}
