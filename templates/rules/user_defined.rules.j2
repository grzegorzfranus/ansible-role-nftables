#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

# =============================================================================
# NFTables User-Defined Rules
# =============================================================================
# This file defines user-defined rules for the NFTables firewall.
# It configures dedicated chains for custom rules which are referenced
# from the main input, forward and output chains in the base.rules.j2 file.
# =============================================================================

{% macro render_user_rule(rule, chain_name) %}
{% set has_src = rule.source is defined %}
{% set has_dst = rule.destination is defined %}
{% set src_v4 = [] %}
{% set src_v6 = [] %}
{% set src_is_list = false %}
{% if has_src %}
    {% if rule.source is string %}
        {% if ':' in rule.source %}
            {% set _ = src_v6.append(rule.source) %}
        {% else %}
            {% set _ = src_v4.append(rule.source) %}
        {% endif %}
    {% else %}
        {% set src_is_list = true %}
        {% for s in rule.source %}
            {% if ':' in s %}
                {% set _ = src_v6.append(s) %}
            {% else %}
                {% set _ = src_v4.append(s) %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endif %}
{% set dst_v4 = [] %}
{% set dst_v6 = [] %}
{% set dst_is_list = false %}
{% if has_dst %}
    {% if rule.destination is string %}
        {% if ':' in rule.destination %}
            {% set _ = dst_v6.append(rule.destination) %}
        {% else %}
            {% set _ = dst_v4.append(rule.destination) %}
        {% endif %}
    {% else %}
        {% set dst_is_list = true %}
        {% for d in rule.destination %}
            {% if ':' in d %}
                {% set _ = dst_v6.append(d) %}
            {% else %}
                {% set _ = dst_v4.append(d) %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endif %}
{% if not has_src and not has_dst %}
    {% set families = ['none'] %}
{% elif has_src and not has_dst %}
    {% set families = [] %}
    {% if src_v4 | length > 0 %}{% set _ = families.append('v4') %}{% endif %}
    {% if src_v6 | length > 0 %}{% set _ = families.append('v6') %}{% endif %}
{% elif not has_src and has_dst %}
    {% set families = [] %}
    {% if dst_v4 | length > 0 %}{% set _ = families.append('v4') %}{% endif %}
    {% if dst_v6 | length > 0 %}{% set _ = families.append('v6') %}{% endif %}
{% else %}
    {% set families = [] %}
    {% if src_v4 | length > 0 and dst_v4 | length > 0 %}{% set _ = families.append('v4') %}{% endif %}
    {% if src_v6 | length > 0 and dst_v6 | length > 0 %}{% set _ = families.append('v6') %}{% endif %}
{% endif %}
{% for fam in families %}
{%- set parts = [] -%}
{%- if chain_name in ['input', 'forward'] and rule.in_interface is defined %} {%- set _ = parts.append('iifname ' ~ rule.in_interface) %} {%- endif %}
{%- if chain_name in ['forward', 'output'] and rule.out_interface is defined %} {%- set _ = parts.append('oifname ' ~ rule.out_interface) %} {%- endif %}
{%- if fam == 'v4' -%}
    {%- if has_src -%}
        {%- if src_is_list -%}
            {%- set _ = parts.append('ip saddr { ' ~ src_v4 | join(', ') ~ ' }') -%}
        {%- else -%}
            {%- set _ = parts.append('ip saddr ' ~ src_v4[0]) -%}
        {%- endif -%}
    {%- endif -%}
    {%- if has_dst -%}
        {%- if dst_is_list -%}
            {%- set _ = parts.append('ip daddr { ' ~ dst_v4 | join(', ') ~ ' }') -%}
        {%- else -%}
            {%- set _ = parts.append('ip daddr ' ~ dst_v4[0]) -%}
        {%- endif -%}
    {%- endif -%}
{%- elif fam == 'v6' -%}
    {%- if has_src -%}
        {%- if src_is_list -%}
            {%- set _ = parts.append('ip6 saddr { ' ~ src_v6 | join(', ') ~ ' }') -%}
        {%- else -%}
            {%- set _ = parts.append('ip6 saddr ' ~ src_v6[0]) -%}
        {%- endif -%}
    {%- endif -%}
    {%- if has_dst -%}
        {%- if dst_is_list -%}
            {%- set _ = parts.append('ip6 daddr { ' ~ dst_v6 | join(', ') ~ ' }') -%}
        {%- else -%}
            {%- set _ = parts.append('ip6 daddr ' ~ dst_v6[0]) -%}
        {%- endif -%}
    {%- endif -%}
{%- endif -%}
{%- if rule.protocol is defined %}
    {%- if rule.port is defined %}
        {%- set _ = parts.append(rule.protocol ~ ' dport { ' ~ rule.port ~ ' }') %}
    {%- else %}
        {%- set _ = parts.append('meta l4proto ' ~ rule.protocol) %}
    {%- endif %}
{%- endif %}
{%- if rule.state is defined %}
    {%- set _ = parts.append('ct state { ' ~ rule.state ~ ' }') %}
{%- else %}
    {%- set _ = parts.append('ct state { new }') %}
{%- endif %}
{% set suffix = '' %}
{% if families | length > 1 %}
    {% if fam == 'v4' %}{% set suffix = ' (IPv4)' %}{% elif fam == 'v6' %}{% set suffix = ' (IPv6)' %}{% endif %}
{% endif %}
        {{ parts | join(' ') }}{% if rule.rate_limit is defined %} limit rate {{ rule.rate_limit }} burst {{ rule.burst | default(5) }} packets{% endif %}{% if rule.log | default(false) %} log prefix "[nftables] : {{ rule.action | default('accept') }} : {{ chain_name }} : {% if rule.protocol is defined %}{{ rule.protocol }}{% endif %} : "{% endif %}{% if rule.counter | default(false) %} counter{% endif %} {{ rule.action | default('accept') }} comment "{{ rule.comment | default('User-defined ' ~ chain_name ~ ' rule') }}{{ suffix }}"
{% endfor %}
{% endmacro %}

{% if (nftables_user_defined_input_enabled | default(false) | bool) or
      (nftables_user_defined_forward_enabled | default(false) | bool) or
      (nftables_user_defined_output_enabled | default(false) | bool) %}
# -----------------------------------------------------------------------------
# Extend the Base Filter Table with User-Defined Rules
# -----------------------------------------------------------------------------
table inet filter {
    {% if nftables_user_defined_input_enabled | default(false) | bool %}
    # Define dedicated chain for user-defined input rules
    chain user_defined_input {
        {% for rule in nftables_user_defined_input_rules | default([]) %}
{{ render_user_rule(rule, 'input') -}}
        {% endfor %}
    }
    {% endif %}

    {% if nftables_user_defined_forward_enabled | default(false) | bool %}
    # Define dedicated chain for user-defined forward rules
    chain user_defined_forward {
        {% for rule in nftables_user_defined_forward_rules | default([]) %}
{{ render_user_rule(rule, 'forward') -}}
        {% endfor %}
    }
    {% endif %}

    {% if nftables_user_defined_output_enabled | default(false) | bool %}
    # Define dedicated chain for user-defined output rules
    chain user_defined_output {
        {% for rule in nftables_user_defined_output_rules | default([]) %}
{{ render_user_rule(rule, 'output') -}}
        {% endfor %}
    }
    {% endif %}
}
{% endif %}
