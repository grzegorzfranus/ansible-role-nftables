#jinja2: trim_blocks: True, lstrip_blocks: True
{{ ansible_managed | comment }}

# =============================================================================
# NFTables Cluster Communication Rules
# =============================================================================
# This file defines rules for allowing communication between servers in a cluster.
# It configures dedicated chains for cluster traffic which are referenced
# from the main input and output chains in the base.rules.j2 file.
# =============================================================================

{% if nftables_cluster_enabled | default(false) | bool %}
{% set ipv4_nodes = [] %}
{% set ipv6_nodes = [] %}
{% for node in nftables_cluster_nodes | default([]) %}
    {% if ':' in node %}
        {% set _ = ipv6_nodes.append(node) %}
    {% else %}
        {% set _ = ipv4_nodes.append(node) %}
    {% endif %}
{% endfor %}
# -----------------------------------------------------------------------------
# Extend the Base Filter Table with Cluster Communication Rules
# -----------------------------------------------------------------------------
table inet filter {
    # Define dedicated chain for cluster input traffic
    chain cluster_input {
        {% for rule in nftables_cluster_rules | default([]) %}
        {% if ipv4_nodes | length > 0 %}
        # Allow {{ rule.protocol | default('tcp') }} traffic on port {{ rule.port }} from IPv4 cluster nodes
        ip saddr { {{ ipv4_nodes | join(', ') }} } {{ rule.protocol | default('tcp') }} dport { {{ rule.port }} } {% if rule.state is defined %}ct state {{ rule.state }}{% else %}ct state new,established,related{% endif %} {% if (rule.rate_limit | default('')) | length > 0 %}limit rate {{ rule.rate_limit }}{% if rule.burst is defined %} burst {{ rule.burst }} packets{% endif %} {% endif %}{% if rule.log | default(false) %}log prefix "[nftables] : accept : cluster : {{ rule.protocol | default('tcp') }}/{{ rule.port }} : "{% endif %} counter accept comment "{{ rule.comment | default('Allow ' ~ rule.protocol | default('tcp') ~ '/' ~ rule.port ~ ' from cluster nodes') }}"
        {% endif %}
        {% if ipv6_nodes | length > 0 %}
        # Allow {{ rule.protocol | default('tcp') }} traffic on port {{ rule.port }} from IPv6 cluster nodes
        ip6 saddr { {{ ipv6_nodes | join(', ') }} } {{ rule.protocol | default('tcp') }} dport { {{ rule.port }} } {% if rule.state is defined %}ct state {{ rule.state }}{% else %}ct state new,established,related{% endif %} {% if (rule.rate_limit | default('')) | length > 0 %}limit rate {{ rule.rate_limit }}{% if rule.burst is defined %} burst {{ rule.burst }} packets{% endif %} {% endif %}{% if rule.log | default(false) %}log prefix "[nftables] : accept : cluster : {{ rule.protocol | default('tcp') }}/{{ rule.port }} : "{% endif %} counter accept comment "{{ rule.comment | default('Allow ' ~ rule.protocol | default('tcp') ~ '/' ~ rule.port ~ ' from cluster nodes') }}"
        {% endif %}
        {% endfor %}
    }

    # Define dedicated chain for cluster output traffic
    chain cluster_output {
        {% for rule in nftables_cluster_rules | default([]) %}
        {% if ipv4_nodes | length > 0 %}
        # Allow {{ rule.protocol | default('tcp') }} traffic on port {{ rule.port }} to IPv4 cluster nodes
        ip daddr { {{ ipv4_nodes | join(', ') }} } {{ rule.protocol | default('tcp') }} dport { {{ rule.port }} } {% if rule.state is defined %}ct state {{ rule.state }}{% else %}ct state new,established,related{% endif %} {% if (rule.rate_limit | default('')) | length > 0 %}limit rate {{ rule.rate_limit }}{% if rule.burst is defined %} burst {{ rule.burst }} packets{% endif %} {% endif %}{% if rule.log | default(false) %}log prefix "[nftables] : accept : output : cluster : {{ rule.protocol | default('tcp') }}/{{ rule.port }} : "{% endif %} counter accept comment "{{ rule.comment | default('Allow ' ~ rule.protocol | default('tcp') ~ '/' ~ rule.port ~ ' to cluster nodes') }}"
        {% endif %}
        {% if ipv6_nodes | length > 0 %}
        # Allow {{ rule.protocol | default('tcp') }} traffic on port {{ rule.port }} to IPv6 cluster nodes
        ip6 daddr { {{ ipv6_nodes | join(', ') }} } {{ rule.protocol | default('tcp') }} dport { {{ rule.port }} } {% if rule.state is defined %}ct state {{ rule.state }}{% else %}ct state new,established,related{% endif %} {% if (rule.rate_limit | default('')) | length > 0 %}limit rate {{ rule.rate_limit }}{% if rule.burst is defined %} burst {{ rule.burst }} packets{% endif %} {% endif %}{% if rule.log | default(false) %}log prefix "[nftables] : accept : output : cluster : {{ rule.protocol | default('tcp') }}/{{ rule.port }} : "{% endif %} counter accept comment "{{ rule.comment | default('Allow ' ~ rule.protocol | default('tcp') ~ '/' ~ rule.port ~ ' to cluster nodes') }}"
        {% endif %}
        {% endfor %}
    }
}
{% endif %}
